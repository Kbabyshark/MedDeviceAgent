# ============================================================
# MedDeviceAgent 环境配置模板
# 复制此文件为 .env 并填写实际值
# .env 文件已加入 .gitignore，禁止提交到仓库
# ============================================================

# -------------------- App --------------------
APP_ENV=development
APP_DEBUG=true
APP_NAME=MedDeviceAgent
APP_VERSION=0.1.0

# -------------------- Server --------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# -------------------- MySQL --------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=med_device_agent
MYSQL_POOL_SIZE=20
MYSQL_POOL_RECYCLE=3600

# -------------------- Redis --------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -------------------- Qdrant --------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# -------------------- DeepSeek --------------------
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_V3_MODEL=deepseek-chat
DEEPSEEK_R1_MODEL=deepseek-reasoner

# -------------------- Embedding --------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_API_KEY=sk-your-api-key

# -------------------- ASR / TTS --------------------
# FunASR + SenseVoice (SenseVoiceLarge)
ASR_MODEL_DIR=./models/sensevoice
ASR_MODEL_NAME=iic/SenseVoiceSmall
ASR_DEVICE=cuda:0

# CosyVoice 2 (CosyVoice-300M-SFT)
TTS_MODEL_DIR=./models/cosyvoice2
TTS_MODEL_NAME=CosyVoice-300M-SFT
TTS_DEVICE=cuda:0

# -------------------- JWT --------------------
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------- Rate Limit --------------------
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CREATE_TICKET_PER_MINUTE=3
RATE_LIMIT_TRANSFER_HUMAN_PER_MINUTE=2

# -------------------- Logging --------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -------------------- Celery --------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2


#  venv\Scripts\activate